
# Apollo generated/cache data
apollo_ui/storage/cache/
apollo_ui/__pycache__/
**/__pycache__/
*.pyc

# Build output
apollo_ui/build/
apollo_ui/dist/

# Python environments
.venv/
venv/

# Secrets/environment
.env
*.env

# Large AI/model files
*.gguf
*.safetensors
*.bin

# Apollo workstation private data - do not add new user recordings/state
# NOTE: .gitignore does not untrack previously committed files.
apollo_ui/storage/
apollo_ui/Audio/
apollo_ui/workspace/
apollo_ui/config.local.json
apollo_ui/*.log
apollo_ui/*.db
apollo_ui/*.sqlite
apollo_ui/*.sqlite3

# Locally installed XTTS weights live here or in %LOCALAPPDATA%; never commit.
apollo_ui/models/**
